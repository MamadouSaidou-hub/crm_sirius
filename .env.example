# --- Supabase (Project Settings → API) ---
# URL du projet et clé anonyme (publiques, exposées au navigateur).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Clé service_role — SECRÈTE, jamais côté navigateur (usages serveur uniquement).
SUPABASE_SERVICE_ROLE_KEY=

# --- Askia NET API. Copy to .env.local and fill in (kept server-side only) ---
# Key issued by the Askia DSI ("appClient").
ASKIA_APP_CLIENT=
# Point de vente code (needed for client/contract creation — souscription).
ASKIA_PV_CODE=
# Optional: override the API base URL (defaults to https://api.askianet.com).
ASKIA_API_BASE=https://api.askianet.com
